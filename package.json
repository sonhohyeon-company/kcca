{
  "name": "kcca",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.*",
    "import:imweb": "node --no-warnings scripts/import-imweb.ts",
    "format": "prettier --write app components lib scripts tests *.ts *.json README.md"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.9",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}

# 로컬 개발: 이 파일을 .env.local로 복사합니다. 운영 서버: .env로 만들어 compose.production.yml 옆에 둡니다.
# 비밀번호에는 영문·숫자·-·_만 쓰세요 ($, #, 따옴표, 공백은 설정 파일에서 다르게 읽힙니다).

# 관리자 비밀번호 (12자 이상). 비어 있거나 짧으면 관리자 로그인이 꺼집니다.
ADMIN_PASSWORD=
# DB(kcca.db)와 업로드 파일을 둘 폴더. Docker 운영에서는 compose가 /data로 고정하므로 적지 않아도 됩니다.
DATA_DIR=./data
# 사이트 공개 주소 (메타데이터·사이트맵·링크 미리보기에 사용). 운영 서버에서는 https:// 주소여야 배포됩니다.
SITE_URL=http://localhost:3000
# 공식 도메인으로 전환한 뒤에만 true (검색엔진 수집 허용)
ALLOW_INDEXING=false
